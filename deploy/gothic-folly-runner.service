[Unit]
Description=Gothic Folly effects runner (LED control UI + sACN output)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=gothic-folly-runner
WorkingDirectory=/opt/gothic-folly-runner
Environment=RUNNER_HOST=0.0.0.0
Environment=RUNNER_PORT=3002
ExecStart=/usr/bin/node /opt/gothic-folly-runner/start.mjs
Restart=on-failure
RestartSec=3
# For true isolation, keep TouchKio off core 3 (AllowedCPUs=0-2 on its unit).
Nice=-10
AllowedCPUs=3

[Install]
WantedBy=multi-user.target
